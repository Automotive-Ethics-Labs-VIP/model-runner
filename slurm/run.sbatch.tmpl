#!/bin/bash
#SBATCH -A ${account}
#SBATCH -p ${partition}
#SBATCH --gres=gpu:${gpus}
#SBATCH -c ${cpus}
#SBATCH --mem=${mem}
#SBATCH -t ${time}
#SBATCH -J ${job_name}
#SBATCH -o ${log}
# Generated by modelrunner ${version}. Runs the model fully offline on weights the download step fetched.
set -o pipefail
export HF_HOME=${hf_home}
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TMPDIR=${tmpdir}
echo "job $$SLURM_JOB_ID on $$(hostname) at $$(date -Is)"
nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader || true
${python} -I -m modelrunner run --local ${run_args}
status=$$?
if [ $$status -eq 0 ]; then echo "DONE: ${out}"; else echo "FAILED: exit $$status (results so far: ${results}; rerun with --resume)"; fi
exit $$status
