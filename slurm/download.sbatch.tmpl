#!/bin/bash
#SBATCH -A ${account}
#SBATCH -p ${partition}
#SBATCH -c 4
#SBATCH --mem=16G
#SBATCH -t 04:00:00
#SBATCH -J ${job_name}
#SBATCH -o ${log}
# Generated by modelrunner ${version}. Downloads safetensors weights at a pinned revision on a CPU node,
# so the GPU job never waits on the network.
set -o pipefail
export HF_HOME=${hf_home}
export TMPDIR=${tmpdir}
echo "job $$SLURM_JOB_ID on $$(hostname) at $$(date -Is)"
${python} -I -m modelrunner download --model ${hf_id} --revision ${revision}
status=$$?
if [ $$status -eq 0 ]; then echo "DONE: ${hf_id}@${revision}"; else echo "FAILED: exit $$status"; fi
exit $$status
